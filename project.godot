; Engine configuration file.
; Karnak Prime - Godot 4.7 project

config_version=5

[application]

config/name="Karnak Prime"
config/description="Sci-fi horror FPS. Made with assets from Unvanquished, Duelyst and 0 A.D."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Overlay="*res://scripts/autoload/overlay.gd"
Flow="*res://scripts/autoload/flow.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=0
textures/default_filters/anisotropic_filtering_level=2
limits/cluster_builder/max_clustered_elements=512
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/vram_compression/import_etc2_astc=false

[audio]

general/default_playback_type=0

[input_devices]

pointing/emulate_touch_from_mouse=false
